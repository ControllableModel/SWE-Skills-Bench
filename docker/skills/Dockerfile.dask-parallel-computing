FROM swe-skills-bench-python:latest

# Install dask with all extras
RUN pip install "dask[complete]" --break-system-packages --no-cache-dir

# Clone repo at pinned commit
RUN git clone --depth 1 --filter=blob:none https://github.com/pydata/xarray.git /workspace/xarray \
    && cd /workspace/xarray \
    && git fetch --depth 1 origin b8bfeca3275045ca82adc3401c38444b1ed12c4a \
    && git checkout b8bfeca3275045ca82adc3401c38444b1ed12c4a

WORKDIR /workspace
CMD ["/bin/bash"]
