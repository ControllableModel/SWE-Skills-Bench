FROM swe-skills-bench-python:latest

# Install starlette (httpx already in base)
RUN pip install starlette --break-system-packages --no-cache-dir

# Clone repo at pinned commit
RUN git clone --depth 1 --filter=blob:none https://github.com/encode/starlette.git /workspace/starlette \
    && cd /workspace/starlette \
    && git fetch --depth 1 origin 0a29b5ccdcbd1285c75c4fdb5d62ae1d244a21b0 \
    && git checkout 0a29b5ccdcbd1285c75c4fdb5d62ae1d244a21b0

WORKDIR /workspace
CMD ["/bin/bash"]
