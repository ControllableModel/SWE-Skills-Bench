FROM swe-skills-bench-python:latest

# Install pydantic
RUN pip install pydantic --break-system-packages --no-cache-dir

# Clone repo at pinned commit
RUN git clone --depth 1 --filter=blob:none https://github.com/fastapi/fastapi.git /workspace/fastapi \
    && cd /workspace/fastapi \
    && git fetch --depth 1 origin 88021c3dc016d02fe609397cb034648262c270e8 \
    && git checkout 88021c3dc016d02fe609397cb034648262c270e8

WORKDIR /workspace
CMD ["/bin/bash"]
