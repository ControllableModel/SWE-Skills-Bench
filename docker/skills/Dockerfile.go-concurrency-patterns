FROM swe-skills-bench-golang:latest

# Clone repo at pinned commit
RUN git clone --depth 1 --filter=blob:none https://github.com/hashicorp/consul /workspace/go-concurrency-patterns \
    && cd /workspace/go-concurrency-patterns \
    && git fetch --depth 1 origin 329127db328cb3282b51e43bf1d327f76c832602 \
    && git checkout 329127db328cb3282b51e43bf1d327f76c832602

# Go skills typically just need go mod download
RUN cd /workspace/go-concurrency-patterns && go mod download 2>/dev/null || true

WORKDIR /workspace
CMD ["/bin/bash"]
