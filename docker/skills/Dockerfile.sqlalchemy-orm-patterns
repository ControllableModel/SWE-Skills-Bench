FROM swe-skills-bench-python:latest

# Install sqlalchemy
RUN pip install sqlalchemy --break-system-packages --no-cache-dir

# Clone repo at pinned commit
RUN git clone --depth 1 --filter=blob:none https://github.com/getredash/redash.git /workspace/redash \
    && cd /workspace/redash \
    && git fetch --depth 1 origin e2437d8db8c8d12eaf23b7800b58ed3e9ea50353 \
    && git checkout e2437d8db8c8d12eaf23b7800b58ed3e9ea50353

WORKDIR /workspace
CMD ["/bin/bash"]
