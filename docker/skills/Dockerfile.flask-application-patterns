FROM swe-skills-bench-python:latest

# Install flask, flask-sqlalchemy, and flask-migrate
RUN pip install flask flask-sqlalchemy flask-migrate --break-system-packages --no-cache-dir

# Clone repo at pinned commit
RUN git clone --depth 1 --filter=blob:none https://github.com/miguelgrinberg/flasky.git /workspace/flasky \
    && cd /workspace/flasky \
    && git fetch --depth 1 origin 3beedd640b9146b0bd65c8c2ecf402b01798bc33 \
    && git checkout 3beedd640b9146b0bd65c8c2ecf402b01798bc33

WORKDIR /workspace
CMD ["/bin/bash"]
