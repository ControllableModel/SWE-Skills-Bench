FROM swe-skills-bench-golang:latest

# Clone repo at pinned commit
RUN git clone --depth 1 --filter=blob:none https://github.com/containerd/containerd /workspace/logrus-structured-logging \
    && cd /workspace/logrus-structured-logging \
    && git fetch --depth 1 origin b3e484a57a0ae02e9847def88f8115ed1fa8f0bd \
    && git checkout b3e484a57a0ae02e9847def88f8115ed1fa8f0bd

# Go skills typically just need go mod download
RUN cd /workspace/logrus-structured-logging && go mod download 2>/dev/null || true

WORKDIR /workspace
CMD ["/bin/bash"]
