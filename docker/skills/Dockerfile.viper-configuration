FROM swe-skills-bench-golang:latest

# Clone repo at pinned commit
RUN git clone --depth 1 --filter=blob:none https://github.com/gohugoio/hugo /workspace/viper-configuration \
    && cd /workspace/viper-configuration \
    && git fetch --depth 1 origin 72b85d5f9c2d40c06b81d496cd3ccf1f2105c383 \
    && git checkout 72b85d5f9c2d40c06b81d496cd3ccf1f2105c383

# Go skills typically just need go mod download
RUN cd /workspace/viper-configuration && go mod download 2>/dev/null || true

WORKDIR /workspace
CMD ["/bin/bash"]
