FROM swe-skills-bench-python:latest

# Install alembic and sqlalchemy
RUN pip install alembic sqlalchemy --break-system-packages --no-cache-dir

# Clone repo at pinned commit
RUN git clone --depth 1 --filter=blob:none https://github.com/apache/superset.git /workspace/superset \
    && cd /workspace/superset \
    && git fetch --depth 1 origin a9761932bcb8dc2174764e45a048cc7034b72fbb \
    && git checkout a9761932bcb8dc2174764e45a048cc7034b72fbb

WORKDIR /workspace
CMD ["/bin/bash"]
