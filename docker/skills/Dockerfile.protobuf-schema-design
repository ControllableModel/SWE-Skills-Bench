FROM swe-skills-bench-python:latest

# Install grpcio and grpcio-tools (protoc already in base)
RUN pip install grpcio grpcio-tools --break-system-packages --no-cache-dir

# Clone repo at pinned commit
RUN git clone --depth 1 --filter=blob:none https://github.com/googleapis/googleapis.git /workspace/googleapis \
    && cd /workspace/googleapis \
    && git fetch --depth 1 origin a787482b8b9653f5307f959ddb57c51870dda07f \
    && git checkout a787482b8b9653f5307f959ddb57c51870dda07f

WORKDIR /workspace
CMD ["/bin/bash"]
