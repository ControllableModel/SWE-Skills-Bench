FROM swe-skills-bench-python:latest

# Install mypy
RUN pip install mypy --break-system-packages --no-cache-dir

# Clone repo at pinned commit
RUN git clone --depth 1 --filter=blob:none https://github.com/psf/black.git /workspace/black \
    && cd /workspace/black \
    && git fetch --depth 1 origin 8dcc4865c8f9a2769411db5638927696172cdf75 \
    && git checkout 8dcc4865c8f9a2769411db5638927696172cdf75

WORKDIR /workspace
CMD ["/bin/bash"]
