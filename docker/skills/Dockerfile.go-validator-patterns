FROM swe-skills-bench-golang:latest

# Clone repo at pinned commit
RUN git clone --depth 1 --filter=blob:none https://github.com/flipped-aurora/gin-vue-admin /workspace/go-validator-patterns \
    && cd /workspace/go-validator-patterns \
    && git fetch --depth 1 origin 51b4ea284e9f0b42ac517794ed791e2305cc6c34 \
    && git checkout 51b4ea284e9f0b42ac517794ed791e2305cc6c34

# Go skills typically just need go mod download
RUN cd /workspace/go-validator-patterns && go mod download 2>/dev/null || true

WORKDIR /workspace
CMD ["/bin/bash"]
