FROM swe-skills-bench-node:latest
# Path①: R = tool's own repo (pmndrs/zustand)
RUN git clone --depth 1 --filter=blob:none https://github.com/pmndrs/zustand /workspace/zustand \
    && cd /workspace/zustand && git fetch --depth 1 origin 566b5bf448f4354eb8e35c6243ea3772bdb3be96 && git checkout 566b5bf448f4354eb8e35c6243ea3772bdb3be96
RUN cd /workspace/zustand && (npm install --legacy-peer-deps 2>/dev/null || npm install 2>/dev/null || true)
WORKDIR /workspace
CMD ["/bin/bash"]
