FROM swe-skills-bench-python:latest

# Install shap and lightgbm
RUN pip install shap lightgbm --break-system-packages --no-cache-dir

# Clone repo at pinned commit
RUN git clone --depth 1 --filter=blob:none https://github.com/microsoft/LightGBM.git /workspace/LightGBM \
    && cd /workspace/LightGBM \
    && git fetch --depth 1 origin 9fed960ed0b5733892300db299783d4bbe2e0df1 \
    && git checkout 9fed960ed0b5733892300db299783d4bbe2e0df1

WORKDIR /workspace
CMD ["/bin/bash"]
