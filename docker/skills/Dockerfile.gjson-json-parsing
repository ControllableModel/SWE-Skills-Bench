FROM swe-skills-bench-golang:latest

# Clone repo at pinned commit
RUN git clone --depth 1 --filter=blob:none https://github.com/traefik/traefik /workspace/gjson-json-parsing \
    && cd /workspace/gjson-json-parsing \
    && git fetch --depth 1 origin 9893e89628425c91faa1fa7768eff8f1ccdc596f \
    && git checkout 9893e89628425c91faa1fa7768eff8f1ccdc596f

# Go skills typically just need go mod download
RUN cd /workspace/gjson-json-parsing && go mod download 2>/dev/null || true

WORKDIR /workspace
CMD ["/bin/bash"]
