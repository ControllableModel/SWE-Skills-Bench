FROM swe-skills-bench-python:latest

# Install numba and librosa
RUN pip install numba librosa --break-system-packages --no-cache-dir

# Clone repo at pinned commit
RUN git clone --depth 1 --filter=blob:none https://github.com/librosa/librosa.git /workspace/librosa \
    && cd /workspace/librosa \
    && git fetch --depth 1 origin e403272fc984bc4aeb316e5f15899042224bb9fe \
    && git checkout e403272fc984bc4aeb316e5f15899042224bb9fe

WORKDIR /workspace
CMD ["/bin/bash"]
