FROM swe-skills-bench-node:latest
# Path①: R = tool's own repo (sequelize/sequelize)
RUN git clone --depth 1 --filter=blob:none https://github.com/sequelize/sequelize /workspace/sequelize \
    && cd /workspace/sequelize && git fetch --depth 1 origin 8260c2905e22f92b8c908023faaf4ad99994981c && git checkout 8260c2905e22f92b8c908023faaf4ad99994981c
RUN cd /workspace/sequelize && (npm install --legacy-peer-deps 2>/dev/null || npm install 2>/dev/null || true)
